<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Offline Licensing Model (OLM)"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1A202C"
            android:gravity="center"
            android:paddingBottom="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tân Hưng Hà - Quản lý Bản Quyền Ngoại Tuyến"
            android:textSize="12sp"
            android:textColor="#718096"
            android:gravity="center"
            android:paddingBottom="12dp" />

        <!-- Security Badge: Root Checker Status -->
        <TextView
            android:id="@+id/tv_root_security_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BẢO MẬT HỆ THỐNG: ĐANG KIỂM TRA..."
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:background="#E8F5E9"
            android:padding="8dp"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <!-- Card 1: Device Fingerprint -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MÃ VÂN TAY THIẾT BỊ (DEVICE FINGERPRINT)"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#4A5568" />

            <TextView
                android:id="@+id/tv_df_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="---- - ---- - ---- - ----"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#2B6CB0"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/btn_copy_df"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sao Chép Mã DF"
                android:textAllCaps="false"
                android:textSize="13sp" />

        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="12dp" />

        <!-- Card 2: Trạng Thái Bản Quyền Hiện Tại -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRẠNG THÁI BẢN QUYỀN (LICENSE STATUS)"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#4A5568" />

            <TextView
                android:id="@+id/tv_license_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CHƯA KÍCH HOẠT"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#C53030"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/tv_license_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chưa có license nào được kích hoạt trên máy."
                android:textSize="12sp"
                android:textColor="#2D3748"
                android:paddingBottom="4dp" />

        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="12dp" />

        <!-- Card 3: Nhập & Kích Hoạt License + Hardware Scanner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KÍCH HOẠT BẢN QUYỀN (MẮT QUÉT PHẦN CỨNG MT90)"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#4A5568"
                android:paddingBottom="6dp" />

            <!-- Nút bật tia laser quét mã phần cứng -->
            <Button
                android:id="@+id/btn_trigger_laser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bật Tia Quét Laser"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:backgroundTint="#2B6CB0"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="* Hướng đầu đọc vào mã QR License rồi bấm nút trên hoặc phím vàng."
                android:textSize="11sp"
                android:textColor="#718096"
                android:paddingTop="4dp"
                android:paddingBottom="8dp" />

            <EditText
                android:id="@+id/edt_license_token"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:hint="Chuỗi Token từ mắt đọc quét được sẽ tự điền vào đây..."
                android:textSize="11sp"
                android:gravity="top|start"
                android:background="#EDF2F7"
                android:padding="8dp"
                android:fontFamily="monospace"
                android:inputType="textMultiLine" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp">

                <Button
                    android:id="@+id/btn_activate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Kích Hoạt Thủ Công"
                    android:textAllCaps="false"
                    android:textSize="12sp" />

                <View android:layout_width="8dp" android:layout_height="match_parent" />

                <Button
                    android:id="@+id/btn_load_demo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nạp Mẫu Demo"
                    android:textAllCaps="false"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="4dp">

                <Button
                    android:id="@+id/btn_reverify"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Kiểm Tra Lại"
                    android:textAllCaps="false"
                    android:textSize="12sp" />

                <View android:layout_width="8dp" android:layout_height="match_parent" />

                <Button
                    android:id="@+id/btn_reset_license"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Xóa Bản Quyền"
                    android:textAllCaps="false"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="12dp" />

        <!-- Card 4: Chẩn đoán Phần Cứng & Canonical -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THÔNG SỐ PHẦN CỨNG VÀ CANONICAL DEBUG"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#4A5568"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/sample_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Đang tải dữ liệu thiết bị..."
                android:textSize="11sp"
                android:textColor="#2D3748"
                android:fontFamily="monospace" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
